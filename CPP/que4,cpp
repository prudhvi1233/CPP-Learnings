// Swap Two Numbers

// Write a function using pointers to swap two integers.

#include <iostream>
using namespace std;

void swap(int *a, int *b){
    int temp;
    temp = *a;
    *a = *b;
    *b = temp;
    
    cout<<"values after swapped in outside the main function are: ";
    cout<<*a<<" "<<*b<<endl;
}

int main(){
    int a;
    cout<<"Enter a: ";
    cin>>a;
    
    int b;
    cout<<"Enter b: ";
    cin>>b;
    
    swap(&a,&b);
    
    cout<<"values after swapped in inside the main function are: ";
    cout<<a<<" "<<b<<endl;
}

 /* main concept we use pointers to swap two numbers. We pass the address of the variables to
 the swap function, which allows us to modify the original values directly. The function 
 dereferences the pointers to access and swap the values of the integers. */